# App
APP_NAME=Football Tech API
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

# Security
SECRET_KEY=your_secret_key_here

# Observability
LOG_LEVEL=DEBUG
OTLP_ENDPOINT=http://localhost:4317

# Comandos Alembic útiles:
# alembic revision --autogenerate -m "descripcion"  → genera migración
# alembic upgrade head                               → aplica todas
# alembic downgrade -1                               → revierte la última
# alembic history                                    → historial
# alembic current                                    → versión actual


# Email
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@yourdomain.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
MAIL_ENABLED=False

# Frontend
FRONTEND_URL=http://localhost:3000

# AI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=true

# LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_key
LANGCHAIN_PROJECT=football-tech-api